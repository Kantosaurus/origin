# Rust build artifacts
/target/
**/target/
/target-tdd/
/target-clippy/
/target-test/
**/*.rs.bk
*.pdb

# Local gaps analysis / planning docs — kept on disk, not tracked
/Gaps.md
/docs/gaps-implementation-plan.md
/docs/gaps-overnight-tracker.md

# proptest regression files (auto-generated)
**/*.proptest-regressions

# Cargo
.cargo/

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Regression-benchmark scratch results (bench/regression/baselines/ stays tracked)
/bench/regression/out/

# Python bytecode (e.g. `py_compile` of the bench scripts)
__pycache__/

# Logs / temp
*.log
*.tmp
*.bak

# Superpowers local session state (brainstorm servers, pids) — never tracked
.superpowers/
